		<introduction>
			<para>Version 1.0.3 was released on 20th January, 2025.
			</para>
		</introduction>

		<section>
			<title>Changes in This Release</title>
			<content>

				<list class="bullet">
					<listItem>
						<para>This release removes support for .NET 6 and introduces support for .NET 9.</para>
					</listItem>

				</list>

			</content>
		</section>

